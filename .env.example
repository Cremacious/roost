# Roost environment variables (template)
#
# Copy this file to .env.local for local development and fill in real values.
# In production, set these in the Vercel project (Settings > Environment
# Variables) for both the Production and Preview environments.
#
# validateEnv() runs at server boot (src/instrumentation.ts) and throws if any
# REQUIRED var below is missing or blank, so the app will not start until every
# required value is present. See docs/DEPLOYMENT.md for the full runbook.


# ===== REQUIRED =====

# Database (Neon). Use the POOLED connection string: the hostname must contain
# "-pooler" (e.g. ...-pooler.neon.tech). Neon dashboard > Connection Details >
# Connection pooling. This is what makes it safe for serverless.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Auth (better-auth). BETTER_AUTH_SECRET signs sessions, minimum 32 chars.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# The canonical deployed base URL (no trailing slash). In production this is
# your Vercel URL, e.g. https://roost.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Public base URL used for invite links and redirects. Same value as
# BETTER_AUTH_URL in production. Must be the real deployed URL, not localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (use TEST-mode keys until you go live).
# Secret key: Stripe dashboard > Developers > API keys (test mode).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Webhook signing secret: created when you add the webhook endpoint pointing at
# https://YOUR-DEPLOYED-URL/api/stripe/webhook (Stripe > Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Publishable key (safe to expose client-side). Test mode.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# Price ID for the $4/month subscription. Stripe > Product catalog > your
# product > Pricing. Test-mode price starts with price_...
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# Cron security. Vercel Cron sends this as "Authorization: Bearer <value>" to
# every /api/cron/* route, and each route rejects anything else with a 401.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32


# ===== OPTIONAL (feature stays disabled until set) =====

# Resend API key for transactional email (invite links, password reset).
# Missing = those emails are silently skipped. https://resend.com > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Azure Document Intelligence for receipt scanning (premium feature).
# Create an F0 (free, 500 scans/month) resource in the Azure portal, then copy
# Keys and Endpoint. Missing = receipt scanning returns 503.
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Expo push notifications (used by the future mobile app). Web never sends push.
# Missing = push disabled. https://expo.dev > Access Tokens
EXPO_ACCESS_TOKEN=your-expo-access-token

# Admin panel (/admin) login. If either is missing the panel cannot be used.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=a-strong-admin-password
# Optional dedicated signing secret for admin JWTs. Falls back to
# BETTER_AUTH_SECRET when unset.
ADMIN_JWT_SECRET=

# Google sign-in (better-auth social provider). Both must be set to enable the
# "Continue with Google" button; otherwise it is not registered and only
# email/password login is offered. Google Cloud Console > Credentials.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Apple sign-in (better-auth social provider). All four must be set to enable
# it; otherwise the provider is skipped.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
